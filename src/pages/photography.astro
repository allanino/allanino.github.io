---
import BaseLayout from '../layouts/BaseLayout.astro';

const photos = [
  { url: "https://live.staticflickr.com/7867/47098563632_2cee12ae4b_k.jpg", title: "Dyrhólaey arch" },
  { url: "https://live.staticflickr.com/7859/47150910501_7f8788e4c3_k.jpg", title: "Diamond Beach" },
  { url: "https://live.staticflickr.com/7905/47098567762_dfcd2f9dd3_k.jpg", title: "A Winter Scene" },
  { url: "https://live.staticflickr.com/7898/47098611912_c8b9e7fb5c_k.jpg", title: "Cats from Tierra del Fuego" },
  { url: "https://live.staticflickr.com/7813/47098615212_4291216e0e_k.jpg", title: "Lago Escondido" },
  { url: "https://live.staticflickr.com/7880/47098617192_33f01bce3e_k.jpg", title: "Paso Garibaldi" }
];
---
<BaseLayout title="Photography">
  <div class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">Photography</h1>
    <p class="text-zinc-600 dark:text-zinc-400 mb-12 max-w-2xl">
      I love photography, and all the pictures you see in this website are my own work.
      I'm a learner and a hobbyist, exploring the world through my lens.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {photos.map(photo => (
        <figure class="space-y-2">
          <img src={photo.url} alt={photo.title} class="rounded-lg w-full h-64 object-cover shadow-sm" />
          <figcaption class="text-sm text-zinc-500 italic">{photo.title}</figcaption>
        </figure>
      ))}
    </div>
    <div class="mt-16 text-center">
      <a href="https://www.flickr.com/photos/allanino/" class="text-blue-600 hover:underline">View more on Flickr →</a>
    </div>
  </div>
</BaseLayout>
